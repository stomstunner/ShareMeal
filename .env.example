# Express server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sharemeal?retryWrites=true&w=majority

# Supabase (frontend-safe values)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_BUCKET=food-images

# Google OAuth (keep the secret on the Express server)
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:5173/

# Session/JWT secret - generate a long random value
SESSION_SECRET=<long-random-secret>

# Dedicated admin bootstrap login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-admin-password>
